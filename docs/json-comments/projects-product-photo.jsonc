[
  {
    // 穩定識別碼；站內連結與資料對應使用，請勿任意修改。
    "id": "product-photo-watch",
    // 是否納入首頁精選；目前取合併清單中前三筆。
    "featured": false,
    // 畫面顯示的作品類型文字；篩選分類由 projects.js 指定。
    "category": "PRODUCT PHOTOGRAPHY",
    // 畫面顯示的標題。
    "title": "TISSOT PRC200 腕錶－商品攝影",
    // 作品摘要與搜尋內容。
    "summary": "TISSOT PRC200 腕錶錶面特寫。",
    // 實際負責項目。
    "role": "商品攝影",
    // 封面樣式名稱；有 image 時優先顯示圖片。
    "cover": "product-photo",
    // 主要圖片，作品封面使用 /images/... 絕對路徑。
    "image": "/images/projects/product-photography-selection/watch.jpg",
    // 主要圖片的替代文字，供無障礙閱讀。
    "imageAlt": "TISSOT PRC200 腕錶錶面特寫",
    // 作品內頁主圖；省略時沿用 image。
    "detailImage": "/images/projects/product-photography-selection/watch.jpg",
    // 作品內頁主圖的替代文字。
    "detailImageAlt": "TISSOT PRC200 腕錶錶面特寫",
    // 同系列的圖集，透過共用 MediaLightbox 放大。
    "gallery": [
      {
        // 媒體來源；作品 gallery 使用與主圖同目錄的檔名。
        "src": "watch.jpg",
        // 畫面顯示的標題。
        "title": "腕錶細節",
        // 媒體替代文字。
        "alt": "TISSOT PRC200 腕錶錶面特寫"
      }
    ],
    // 作品內頁的可選思路區塊；每項都需有 heading 與 body。
    "caseStudy": [
      {
        // 作品思路區塊的小標題，可依設計、前端或攝影案例調整。
        "heading": "畫面安排",
        // 作品思路區塊的內文；只寫可由案情與畫面支持的內容。
        "body": "以錶面特寫保留指針、刻度與材質細節，讓觀看焦點集中在腕錶本身。"
      },
      {
        // 作品思路區塊的小標題，可依設計、前端或攝影案例調整。
        "heading": "光線觀察",
        // 作品思路區塊的內文；只寫可由案情與畫面支持的內容。
        "body": "錶面上的反光帶出金屬和鏡面質感，同時保留刻度與指針的辨識度。"
      }
    ]
